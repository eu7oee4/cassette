# 复制成 .env 再填。所有个人配置只活在 .env（已 gitignore）。

# 必填：app 与后端的共享密钥（请求头 X-Auth）
CASSETTE_AUTH_KEY=change-me

# claude CLI：需已安装并登录（凭据走 CLI 登录态，不需要 API key）
CLAUDE_MODEL=opus
CLAUDE_TIMEOUT_SEC=300

# 人设文件（相对 server/）；不存在则用 persona.example.md
PERSONA_FILE=persona.md

# 时区（时间感知注入）与 prompt 里对用户的称呼
APP_TZ=Asia/Shanghai
USER_DISPLAY_NAME=User

# 角色名：替换人设文件里的 {{AGENT_NAME}} 占位符
AGENT_NAME=Cassette

# 可选：Bark 推送 https://github.com/Finb/Bark （断连补投/主动消息通知；留空=不推）
BARK_URL=
# 可选：通知图标（公网可访问的图片 URL；留空=Bark 默认图标）
BARK_ICON=

# wake 调度器（主动性）：PROACTIVE_ENABLED=0 整体关掉；tick 间隔秒（每 tick 只做本地预判）
PROACTIVE_ENABLED=1
WAKE_TICK_SEC=300
